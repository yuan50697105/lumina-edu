# ============================================
# Lumina 墨光 - 环境配置模板
# 复制为 .env 并修改为实际值
# cp .env.example .env
# ============================================

# ─── 应用配置 ───
APP_NAME=Lumina
APP_ENV=production
APP_DEBUG=false
APP_PORT=8080

# ─── JWT 密钥（user-service）───
# 必填：openssl rand -hex 32 生成
JWT_SECRET_KEY=change_me_jwt_secret_key

# ─── PostgreSQL ───
POSTGRES_DB=lumina
POSTGRES_USER=lumina
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# ─── Redis ───
REDIS_PASSWORD=change_me_redis_password
REDIS_PORT=6379

# ─── MinIO ───
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=lumina-files

# ─── Nginx ───
HTTP_PORT=80
HTTPS_PORT=443
DOMAIN=api.lumina.edu

# ─── AI 模型（可选）───
# QWEN_API_KEY=
# GLM_API_KEY=
# SPARK_API_KEY=