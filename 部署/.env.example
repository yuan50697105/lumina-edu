# ============================================
# Lumina 墨光 · 生产环境变量模板
# --------------------------------------------
# 复制为 .env 并填入真实值：
#   cp .env.example .env
# 部署后立即修改所有 _PASSWORD 和 JWT_SECRET_KEY。
# ============================================

# ─── PostgreSQL ───
POSTGRES_USER=lumina
POSTGRES_PASSWORD=<change_me_postgres_password>
POSTGRES_DB=lumina

# ─── MinIO 对象存储 ───
MINIO_ROOT_USER=lumina-minio
MINIO_ROOT_PASSWORD=<change_me_minio_password>

# ─── Redis（可选，当前版本未使用）───
# REDIS_PASSWORD=<change_me_redis_password>

# ─── 全局 JWT 密钥（全部服务共享）───
JWT_SECRET_KEY=<change_me_jwt_secret_key_at_least_32_chars>

# ─── CORS（生产环境域名）───
CORS_ORIGINS=https://lumina.example.edu

# ─── Nginx 域名 ───
DOMAIN=lumina.example.edu
HTTP_PORT=80
HTTPS_PORT=443

# ─── AI 模型供应商 Key（运营端注册模型后配置）───
# 以下 Key 通过环境变量注入，不入库；未配置时网关返回 400/502 且不泄露密钥。
# QWEN_API_KEY=
# GLM_API_KEY=
# SPARK_API_KEY=
# DOUBAO_API_KEY=
# BCE_API_KEY=
# MOONSHOT_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ─── 备份 ───
BACKUP_DIR=./backups
BACKUP_RETAIN_DAYS=30