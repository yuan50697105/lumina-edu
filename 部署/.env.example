# ============================================
# Lumina 墨光 · 生产环境变量模板
# --------------------------------------------
# 复制为 .env 并填入真实值：
#   cp .env.example .env
# 部署后立即修改所有 _PASSWORD 和 JWT_SECRET_KEY。
# ============================================

# ─── MySQL 9.7 ───
MYSQL_ROOT_PASSWORD=<change_me_mysql_root_password>
MYSQL_DATABASE=lumina
MYSQL_USER=lumina
MYSQL_PASSWORD=<change_me_mysql_password>

# ─── Redis（当前单体未使用，预留）───
# REDIS_PASSWORD=<change_me_redis_password>

# ─── 全局 JWT 密钥（全部服务共享）───
JWT_SECRET_KEY=<change_me_jwt_secret_key_at_least_32_chars>

# ─── CORS（生产环境域名）───
CORS_ORIGINS=https://lumina.example.edu

# ─── Nginx 域名 ───
DOMAIN=lumina.example.edu
HTTP_PORT=80
HTTPS_PORT=443

# ─── AI 模型供应商 Key（运营端注册模型后配置）───
# 以下 Key 通过环境变量注入，不入库；未配置时网关返回 400/502 且不泄露密钥。
# QWEN_API_KEY=
# GLM_API_KEY=
# SPARK_API_KEY=
# DOUBAO_API_KEY=
# BCE_API_KEY=
# MOONSHOT_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ─── 备份 ───
BACKUP_DIR=./backups
BACKUP_RETAIN_DAYS=30